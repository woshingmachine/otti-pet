{
  "manifest_version": 3,
  "name": "Otti Pet",
  "version": "1.1",
  "description": "Injects a cute otter image on pages.",

  "icons": {
    "16": "otter.png",
    "48": "otter.png",
    "128": "otter.png"
  },

  "permissions": [
    "activeTab"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["behavior.js", "drag.js", "content.js"],
      "css": ["pet.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["otter.png", "bored-otter.png", "pickup-otter.png"],
      "matches": ["<all_urls>"]
    }
  ]
}